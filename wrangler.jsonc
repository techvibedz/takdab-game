{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takdab-game",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "TakdabRoom"
      }
    ]
  },
  "exports": {
    "TakdabRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
